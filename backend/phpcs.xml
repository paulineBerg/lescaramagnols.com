<?xml version="1.0"?>
<ruleset name="Caramagnols">
  <description>PSR-12 + quelques tolérances pour le legacy.</description>
  <arg name="warning-severity" value="0"/>
  <file>src</file>
  <file>core</file>
  <rule ref="PSR12">
    <exclude name="Generic.Files.SideEffects.FoundWithSymbols"/>
    <exclude name="Generic.Files.LineLength"/>
    <exclude name="Generic.Files.LineEndings.InvalidEOLChar"/>
    <exclude name="Internal.LineEndings.Mixed"/>
    <exclude name="PSR1.Classes.ClassDeclaration.MissingNamespace"/>
    <exclude name="PSR1.Classes.ClassDeclaration.MultipleClasses"/>
    <exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/>
    <exclude name="PSR2.Files.EndFileNewline.NoneFound"/>
    <exclude name="PSR2.Methods.FunctionCallSignature"/>
    <exclude name="PSR12.ControlStructures.ControlStructureSpacing"/>
    <exclude name="PSR12.Files.FileHeader.SpacingAfterBlock"/>
    <exclude name="PSR12.Files.OpenTag.NotAlone"/>
    <exclude name="Squiz.Functions.MultiLineFunctionDeclaration.NewlineBeforeOpenBrace"/>
    <exclude name="Squiz.WhiteSpace.SuperfluousWhitespace.EndLine"/>
  </rule>
  <exclude-pattern>config/*</exclude-pattern>
  <exclude-pattern>core/tools/diagnose_blog_taxonomy.php</exclude-pattern>
  <exclude-pattern>config/*</exclude-pattern>
  <exclude-pattern>config/blog_taxonomy.php</exclude-pattern>
  <exclude-pattern>public/*</exclude-pattern>
  <exclude-pattern>vendor/*</exclude-pattern>
  <exclude-pattern>data/*</exclude-pattern>
  <exclude-pattern>src/Blog/BlogTaxonomy.php</exclude-pattern>
</ruleset>
