{
  "name": "lescaramagnols/backend",
  "type": "project",
  "require": {
    "php": "^8.1",
    "nikic/fast-route": "^1.3",
    "monolog/monolog": "^3.5",
    "symfony/mailer": "^7.0",
    "symfony/mime": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.11",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "autoload": {
    "files": [
      "core/env.php",
      "core/helpers.php"
    ],
    "psr-4": {
      "Caramagnols\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LesCaramagnols\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "check-env": "php core/tools/check_env.php",
    "phpstan": "phpstan analyse",
    "phpcs": "phpcs",
    "lint": [
      "@phpstan",
      "@phpcs"
    ],
    "check-i18n": "php core/tools/check_i18n_keys.php"
  }
}
