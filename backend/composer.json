{
  "name": "lescaramagnols/backend",
  "type": "project",
  "require": {
    "php": "^8.1",
    "nikic/fast-route": "^1.3",
    "monolog/monolog": "^3.5",
    "symfony/mailer": "^7.0",
    "symfony/mime": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5.62",
    "phpstan/phpstan": "^1.11",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "autoload": {
    "files": [
      "core/env.php",
      "core/helpers.php"
    ],
    "psr-4": {
      "Caramagnols\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LesCaramagnols\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "check-env": "php core/tools/check_env.php",
    "phpstan": "phpstan analyse",
    "phpcs": "phpcs",
    "editorial-import-sql": "php core/tools/import_editorial_to_sql.php",
    "blog-import-sql": "php core/tools/import_blog_to_sql.php",
    "blog-taxonomy-diagnose": "php core/tools/diagnose_blog_taxonomy.php",
    "init-db-admin": "php core/tools/init_db_admin.php",
    "benchmark-routes": "php core/tools/benchmark_front_routes.php",
    "generate-sitemap": "php core/tools/generate_sitemap.php",
    "generate-site-summary": "php core/tools/generate_site_summary.php",
    "check-log-alerts": "php core/tools/check_log_alerts.php",
    "check-security-headers": "php core/tools/check_security_headers.php",
    "check-instagram-feed": "php core/tools/check_instagram_feed.php",
    "lint": [
      "@phpstan",
      "@phpcs"
    ],
    "check-i18n": "php core/tools/check_i18n_keys.php"
  }
}
