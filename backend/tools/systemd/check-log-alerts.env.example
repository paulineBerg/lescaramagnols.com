# Copie recommandee: /etc/caramagnols/check-log-alerts.env

# Dossier backend cible (preprod/prod)
BACKEND_DIR=/srv/caramagnols/backend

# Binaire PHP (optionnel)
PHP_BIN=/usr/bin/php

# Fenetre d'analyse (minutes)
CHECK_LOG_ALERTS_SINCE_MINUTES=60

# Active le mode strict (exit code 2 si seuil depasse)
CHECK_LOG_ALERTS_STRICT=true

# Arguments supplementaires (optionnel)
# Exemple: --http-403-threshold=50 --http-429-threshold=20 --fail-on-notify-error
CHECK_LOG_ALERTS_EXTRA_ARGS=

# Fichier de sortie du runner
CHECK_LOG_ALERTS_RUN_LOG=/srv/caramagnols/backend/var/log/check-log-alerts-runner.log

# Notification ops
# notify_on: alerts (defaut) | always
LOG_ALERTS_NOTIFY_ON=alerts

# Evite les mails repetes pour la meme alerte persistante.
# Une nouvelle metrique alerte envoie immediatement, sinon rappel apres ce delai.
LOG_ALERTS_REPEAT_NOTIFY_MINUTES=180
LOG_ALERTS_STATE_FILE=/srv/caramagnols/backend/var/log/check-log-alerts-state.json

# Webhook ops (Slack, Teams, Mattermost, endpoint monitoring, etc.)
LOG_ALERTS_WEBHOOK_URL=
LOG_ALERTS_WEBHOOK_TIMEOUT=8

# Emails ops (separes par virgule)
LOG_ALERTS_EMAIL_TO=
LOG_ALERTS_EMAIL_SUBJECT_PREFIX=[caramagnols-prod]

# Optionnel: retourner exit code 3 si notification configuree mais en echec
LOG_ALERTS_FAIL_ON_NOTIFY_ERROR=false
