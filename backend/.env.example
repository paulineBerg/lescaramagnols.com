APP_ENV=development
BASE_URL=/
DEFAULT_LANG=fr
VITE_DEV_SERVER_URL=http://localhost:5173
# Redirection HTTPS applicative (en complément du serveur web)
# En production: passer FORCE_HTTPS=true.
# En local: activer FORCE_HTTPS_ON_LOCALHOST uniquement si un endpoint HTTPS est disponible.
FORCE_HTTPS=false
FORCE_HTTPS_ON_LOCALHOST=false
# Optionnel: force un port HTTPS spécifique (ex: 18443 en dev).
FORCE_HTTPS_PORT=
# Optionnel: liste d'hôtes exclus (séparés par virgules).
FORCE_HTTPS_EXCLUDED_HOSTS=
# A activer uniquement derriere un reverse proxy de confiance (X-Forwarded-*).
TRUST_PROXY_HEADERS=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=caramagnols
DB_USER=caramagnols
DB_PASSWORD=changeme
DB_CHARSET=utf8mb4
DB_TABLE_PREFIX=car_
EDITORIAL_STORAGE=json

MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_ENCRYPTION=
MAIL_FROM_ADDRESS=contact@example.com
MAIL_FROM_NAME="Les Caramagnols"

# Admin dashboard (obligatoire a personnaliser)
ADMIN_LOGIN_PATH=admin-change-me
ADMIN_EMAIL=admin@example.com
# Généré via php -r "echo password_hash('admin', PASSWORD_DEFAULT);"
# Laisser vide tant qu'aucun compte admin n'est créé
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_KEY=change-this-admin-session-key
# Langue unique de l'interface admin, independante du cookie public lang
ADMIN_LANGUAGE=fr
# Optionnel : limiter l'admin a certaines IPs/CIDR, ex. 203.0.113.10,198.51.100.0/24
ADMIN_ALLOWED_IPS=127.0.0.1,::1
# A activer uniquement derrière un proxy de confiance
ADMIN_TRUST_PROXY_HEADERS=false
# Frein anti brute-force sur l'écran de connexion admin
ADMIN_LOGIN_RATE_LIMIT_ATTEMPTS=5
ADMIN_LOGIN_RATE_LIMIT_WINDOW=900
# Session admin: coupure automatique après inactivité (120 min par défaut)
ADMIN_INACTIVITY_TIMEOUT_SECONDS=7200
# Ré-authentification requise sur actions sensibles au-delà de cette durée (120 min par défaut)
ADMIN_REAUTH_TIMEOUT_SECONDS=7200
# 2FA TOTP (désactivé en local si ADMIN_TOTP_SKIP_LOCALHOST=true)
ADMIN_TOTP_ENABLED=false
ADMIN_TOTP_SECRET=
ADMIN_TOTP_SKIP_LOCALHOST=true

# Secrets API (a fournir via variables d'environnement, pas via fichiers versionnes)
DISCUSSIONS_RECAPTCHA_SITE_KEY=
DISCUSSIONS_RECAPTCHA_SECRET_KEY=
INSTAGRAM_USERNAME=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Blog administré via backend/public/index.php
BLOG_MODE=experimental
# Modes: json | dual-write | sql (fallback sur EDITORIAL_STORAGE si vide)
BLOG_STORAGE=json
# Exemple :
# BLOG_DATA_DIR=/home/app/caramagnols/backend/data/blog
BLOG_DATA_DIR=

# Logging (rotation locale non bloquante)
LOG_RETENTION_FILES=14
LOG_ROTATION_MAX_BYTES=5242880
# Alertes logs (ops) : scheduler + webhook/email
# notify_on: alerts (defaut) | always
LOG_ALERTS_NOTIFY_ON=alerts
# webhook ops (Slack, Teams, monitoring endpoint)
LOG_ALERTS_WEBHOOK_URL=
LOG_ALERTS_WEBHOOK_TIMEOUT=8
# emails ops (separes par virgule)
LOG_ALERTS_EMAIL_TO=
LOG_ALERTS_EMAIL_SUBJECT_PREFIX=[caramagnols]
# optionnel: exit code 3 si notification configuree mais en echec
LOG_ALERTS_FAIL_ON_NOTIFY_ERROR=false

# Verification headers securite (outil CLI preprod)
PREPROD_CHECK_URL=
